{
  "name": "dsh-compaction-policy",
  "version": "0.2.0",
  "description": "Global 90% native compaction for DeepSeek Harness: summary-first pressure, reversible integration, and legacy-session compatibility.",
  "type": "module",
  "license": "MIT",
  "author": "huohua-dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huohua-dev/dsh-compaction-policy.git"
  },
  "bugs": { "url": "https://github.com/huohua-dev/dsh-compaction-policy/issues" },
  "homepage": "https://github.com/huohua-dev/dsh-compaction-policy#readme",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./policy": "./src/policy.js",
    "./preset": "./src/preset.js",
    "./global": "./src/global.js",
    "./legacy": "./src/legacy.js",
    "./package.json": "./package.json"
  },
  "files": ["src", "scripts", "test", "cordis.patch.yml", "README.md", "README.zh-CN.md", "CONTRIBUTING.md", "SECURITY.md", "CHANGELOG.md", "NOTICE.md", "LICENSE"],
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "peerDependencies": {
    "@deepseek-ai/dsh-compaction-basic": "0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction": "0.2.0-rc.2",
    "@deepseek-ai/dsh-web-app": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.0-rc.2",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.5",
    "@deepseek-ai/cordis-plugin-include": "~1.0.9",
    "@deepseek-ai/schemastery": "~3.18.4",
    "js-yaml": "^4.3.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-compaction-basic": { "optional": true },
    "@deepseek-ai/dsh-compaction": { "optional": true },
    "@deepseek-ai/dsh-web-app": { "optional": true },
    "@deepseek-ai/dsh-agent-preset-registry": { "optional": true },
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/cordis-plugin-loader": { "optional": true },
    "@deepseek-ai/cordis-plugin-include": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "js-yaml": { "optional": true }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:host": "node scripts/test-host.mjs",
    "check": "node scripts/check.mjs",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "prepublishOnly": "npm run check && npm test"
  },
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "compaction", "context-window", "output-reservation"],
  "publishConfig": { "access": "public" }
}
